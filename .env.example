# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# --- Convex (written for you by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Clerk (Dashboard > your app > API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret: server only.
CLERK_SECRET_KEY=

# --- Set on the Convex deployment, not here ---
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-instance>.clerk.accounts.dev
# npx convex env set N8N_NOTIFY_URL https://<your-n8n>/webhook/lendloop-notify
# npx convex env set LENDLOOP_WEBHOOK_SECRET <64 random hex characters>
#   The same secret goes in the n8n Crypto credential "LendLoop webhook secret" (HMAC secret field).

    {"id":"d573be84-5265-4c31-9ac4-8bb3b423c489","name":"Sticky Note c053207c","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[192,-96],"parameters":{"content":"## Who needs a reminder?\nSigned POST to Convex (HMAC over `t.body`, secret in the **LendLoop webhook secret** credential). Convex returns only overdue loans not yet reminded today, with just the borrower email, first names, tool and end date.","color":5,"width":608,"height":224}},

    {"id":"2e54a8e7-b98e-4cd1-a006-69df173563da","name":"Send reminder email","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1120,0],"parameters":{"resource":"message","operation":"send","sendTo":"={{ $json.recipientEmail }}","subject":"=Friendly reminder: the {{ $json.toolName }}","emailType":"text","message":"=Hi {{ $json.recipientFirstName }},\n\nFriendly reminder: the {{ $json.toolName }} was due back on {{ DateTime.fromISO($json.endDate, { zone: 'utc' }).toFormat('cccc d LLLL') }}.\n\nIf you need a little more time, just let {{ $json.lenderFirstName }} know. Once it is back, {{ $json.lenderFirstName }} can mark it returned on LendLoop.\n\nThanks for looking after it,\nLendLoop","options":{"appendAttribution":false,"senderName":"LendLoop"}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":3000,"onError":"continueRegularOutput","webhookId":"f6923e2b-7cd5-4c3b-9ca2-3ead36c4fb96","credentials":{"gmailOAuth2":{"id":"SWEymoBYgIehF42s","name":"LendLoop Gmail"}}},
    {"id":"8fcf26f6-44c3-42f8-92d5-7f4e9ec69780","name":"Build status report","type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,0],"parameters":{"mode":"runOnceForEachItem","language":"javaScript","jsCode":"const r = $('One item per reminder').item.json;\nconst failed = !!$json.error;\nconst report = { idempotencyKey: r.idempotencyKey, loanId: r.loanId, status: failed ? 'failed' : 'sent' };\nif (failed) {\n  const raw = String($json.error?.message ?? $json.error ?? 'Email could not be sent.');\n  report.detail = raw.replace(/[^\\s@]+@[^\\s@]+/g, '[address]').replace(/\\s+/g, ' ').trim().slice(0, 200);\n}\nconst body = JSON.stringify(report);\nconst t = Math.floor(Date.now() / 1000);\nreturn { json: { body, t, toSign: t + '.' + body } };"}},
